      {
        "schema": "public",
        "table": "work_accesses",
        "name": "work_access_cleanup_lock",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
        "command": "UPDATE",
        "using": "(workspace_id = work_access_cleanup_workspace_id())",
        "check": "false"
