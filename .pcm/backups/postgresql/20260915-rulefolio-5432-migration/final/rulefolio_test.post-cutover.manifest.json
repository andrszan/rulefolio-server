      {
        "schema": "public",
        "table": "work_accesses",
        "name": "work_access_delete",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
        "command": "DELETE",
        "using": "(((work_id = work_management_id()) AND (workspace_id = work_management_workspace_id())) OR (workspace_id = work_access_cleanup_workspace_id()))",
        "check": null
      },
      {
        "schema": "public",
        "table": "work_accesses",
        "name": "work_access_insert",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
        "command": "INSERT",
        "using": null,
        "check": "((work_id = work_management_id()) AND (workspace_id = work_management_workspace_id()) AND (EXISTS ( SELECT 1\n   FROM workspace_members member\n  WHERE ((member.workspace_id = work_management_workspace_id()) AND (member.account_id = work_accesses.account_id)))))"
      },
      {
        "schema": "public",
        "table": "work_accesses",
        "name": "work_access_read",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
        "command": "SELECT",
        "using": "((account_id = workspace_actor_id()) OR ((work_id = work_management_id()) AND (workspace_id = work_management_workspace_id())) OR (workspace_id = work_access_cleanup_workspace_id()))",
        "check": null
      },
      {
        "schema": "public",
        "table": "work_accesses",
        "name": "work_access_update",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
        "command": "UPDATE",
        "using": "((work_id = work_management_id()) AND (workspace_id = work_management_workspace_id()))",
        "check": "((work_id = work_management_id()) AND (workspace_id = work_management_workspace_id()) AND (EXISTS ( SELECT 1\n   FROM workspace_members member\n  WHERE ((member.workspace_id = work_management_workspace_id()) AND (member.account_id = work_accesses.account_id)))))"
      },
      {
        "schema": "public",
        "table": "works",
        "name": "work_insert",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
        "command": "INSERT",
        "using": null,
        "check": "(EXISTS ( SELECT 1\n   FROM workspace_members member\n  WHERE ((member.workspace_id = works.workspace_id) AND (member.account_id = workspace_actor_id()))))"
      },
      {
        "schema": "public",
        "table": "works",
        "name": "work_read",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
        "command": "SELECT",
        "using": "(((EXISTS ( SELECT 1\n   FROM workspace_members member\n  WHERE ((member.workspace_id = works.workspace_id) AND (member.account_id = workspace_actor_id())))) AND (EXISTS ( SELECT 1\n   FROM work_accesses access\n  WHERE ((access.work_id = works.id) AND (access.account_id = workspace_actor_id()))))) OR ((id = work_management_id()) AND (EXISTS ( SELECT 1\n   FROM workspace_members member\n  WHERE ((member.workspace_id = works.workspace_id) AND (member.account_id = workspace_actor_id()))))))",
        "check": null
      },
      {
        "schema": "public",
        "table": "works",
        "name": "work_update",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
        "command": "UPDATE",
        "using": "((id = work_management_id()) AND (EXISTS ( SELECT 1\n   FROM workspace_members member\n  WHERE ((member.workspace_id = works.workspace_id) AND (member.account_id = workspace_actor_id())))) AND (EXISTS ( SELECT 1\n   FROM work_accesses access\n  WHERE ((access.work_id = works.id) AND (access.account_id = workspace_actor_id()) AND ((access.role)::text = 'maintainer'::text)))))",
        "check": "((id = work_management_id()) AND (EXISTS ( SELECT 1\n   FROM workspace_members member\n  WHERE ((member.workspace_id = works.workspace_id) AND (member.account_id = workspace_actor_id())))) AND (EXISTS ( SELECT 1\n   FROM work_accesses access\n  WHERE ((access.work_id = works.id) AND (access.account_id = workspace_actor_id()) AND ((access.role)::text = 'maintainer'::text)))))"
      },
