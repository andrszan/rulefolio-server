      {
        "schema": "public",
        "table": "workspaces",
        "name": "workspace_read",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
        "command": "SELECT",
        "using": "((owner_account_id = workspace_actor_id()) OR (id = workspace_maintenance_id()) OR (EXISTS ( SELECT 1\n   FROM workspace_members member\n  WHERE ((member.workspace_id = workspaces.id) AND (member.account_id = workspace_actor_id())))) OR (EXISTS ( SELECT 1\n   FROM workspace_invitations invitation\n  WHERE ((invitation.workspace_id = workspaces.id) AND (invitation.credential_id = workspace_invitation_credential_id())))))",
        "check": null
