      {
        "schema": "public",
        "table": "workspace_members",
        "name": "workspace_member_insert",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
        "command": "INSERT",
        "using": null,
        "check": "((workspace_id = workspace_management_id()) OR (EXISTS ( SELECT 1\n   FROM workspace_invitations invitation\n  WHERE ((invitation.workspace_id = workspace_members.workspace_id) AND (invitation.account_id = workspace_members.account_id) AND (invitation.credential_id = workspace_invitation_credential_id()) AND ((invitation.status)::text = 'active'::text)))))"
      },
      {
        "schema": "public",
        "table": "workspace_members",
        "name": "workspace_member_read",
        "permissive": "PERMISSIVE",
        "roles": [
          "public"
        ],
