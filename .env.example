DB_HOST=127.0.0.1
DB_PORT=5436
DB_NAME=rulefolio_dev
TEST_DB_NAME=rulefolio_test
DB_USER=rulefolio_app
DB_PASSWORD=change-me
# 仅 Alembic 使用 schema owner；API 与邮件派发只使用上面的 DB_* 运行身份。
MIGRATOR_DB_HOST=127.0.0.1
MIGRATOR_DB_PORT=5436
MIGRATOR_DB_NAME=rulefolio_dev
MIGRATOR_DB_USER=rulefolio_migrator
MIGRATOR_DB_PASSWORD=change-me
APP_NAME='好玩实验室 API'
APP_VERSION=1.0.0
APP_PUBLIC_URL=http://127.0.0.1:3105
API_PREFIX=/api/v1
ENABLE_API_DOCS=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://127.0.0.1:3105"]
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1
SESSION_TTL_HOURS=8
ONE_TIME_TOKEN_TTL_MINUTES=30
AUTH_ATTEMPT_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
RECOVERY_REQUEST_MAX_ATTEMPTS=3
RECOVERY_RESPONSE_MIN_DURATION_MS=250
RECOVERY_JOB_STALE_MINUTES=5
RECOVERY_EXCHANGE_MAX_ATTEMPTS=5
# 由安全随机源生成，均不得提交到版本库。
TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
AUTH_ATTEMPT_PEPPER=change-me

# 私有版本材料与作品图片使用 S3 兼容对象存储。
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_NAME=rulefolio-dev
S3_TEST_BUCKET_NAME=rulefolio-test
S3_USE_PATH_STYLE=true

# 邀请、场次调整与待办触达使用开发 SMTP。
MAIL_DRIVER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=developer@example.com
SMTP_PASSWORD=change-me
MAIL_FROM_NAME='好玩实验室'
MAIL_FROM_ADDRESS=developer@example.com
MAIL_REPLY_TO=developer@example.com
MAIL_MAX_ATTEMPTS=3
MAIL_DISPATCH_STALE_MINUTES=5
MAIL_TEST_RECIPIENT_NAME=
MAIL_TEST_RECIPIENT_ADDRESS=tester@example.com
